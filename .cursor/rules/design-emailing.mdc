## Tailwind v4 — Drop in your `globals.css`

```css
@import "tailwindcss";

@theme {
  /* === COLORS === */
  --color-bg:              #F1F3F8;
  --color-surface-0:       #FFFFFF;
  --color-surface-1:       #F8F9FC;
  --color-border:          #E4E7EF;
  --color-border-subtle:   #EEF0F6;

  --color-text-primary:    #1A1B2E;
  --color-text-secondary:  #5C6380;
  --color-text-muted:      #9299B0;

  --color-accent:          #7C3AED;
  --color-accent-light:    #EDE9FE;
  --color-accent-dark:     #5B21B6;

  --color-positive:        #16A34A;
  --color-positive-bg:     #DCFCE7;
  --color-negative:        #DC2626;
  --color-negative-bg:     #FEE2E2;
  --color-warning:         #D97706;
  --color-warning-bg:      #FEF3C7;

  --color-chart-1:         #7C3AED;
  --color-chart-2:         #F97316;
  --color-chart-3:         #94A3B8;
  --color-chart-area-1:    rgb(124 58 237 / 0.10);

  --color-nav:             #1A1B2E;

  /* === TYPOGRAPHY === */
  --font-sans: "Inter", system-ui, sans-serif;
  --font-mono: "JetBrains Mono", "Fira Code", monospace;

  /* === TYPE SCALE === */
  --text-display:  clamp(28px, 3vw, 32px);
  --text-h1:       clamp(20px, 2vw, 24px);
  --text-h2:       18px;
  --text-h3:       16px;
  --text-body:     14px;
  --text-sm:       13px;
  --text-caption:  12px;

  /* === BORDER RADIUS === */
  --radius-card:   16px;
  --radius-input:  10px;
  --radius-btn:    10px;
  --radius-modal:  20px;
  --radius-badge:  999px;
  --radius-tooltip: 8px;

  /* === SPACING === */
  --spacing-section: 24px;
  --spacing-card:    24px;
  --spacing-gap:     16px;

  /* === LAYOUT === */
  --layout-max:      1280px;
  --layout-sidebar:  240px;
  --layout-topbar:   64px;

  /* === SHADOWS === */
  --shadow-modal: 0 20px 60px rgb(26 27 46 / 0.12);
}
```

